{
  "name": "astron-design-system",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test:theme": "node scripts/check-theme.mjs",
    "test:search": "node scripts/check-member-search.mjs",
    "test:workspace": "node scripts/check-workspace.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "format": "prettier --write src index.html vite.config.ts tsconfig.json package.json",
    "test:schedule": "node scripts/check-schedule.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.0",
    "prettier": "^3.6.0",
    "vite": "^7.1.0"
  }
}
